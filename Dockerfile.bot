FROM oven/bun:1.3-slim AS base

WORKDIR /app

ENV DATABASE_HOST="dummy"
ENV DATABASE_PORT="3306"
ENV DATABASE_USER="dummy"
ENV DATABASE_PASSWORD="dummy"
ENV DATABASE_NAME="dummy"

# --------------------------------------------------
# Dependencies & Builder
# --------------------------------------------------
FROM base AS builder

# Copy all package manifests and source files needed for install/build
COPY package.json bun.lock ./
COPY apps/bot ./apps/bot
COPY apps/web/package.json ./apps/web/package.json
COPY packages/database ./packages/database
COPY tsconfig.json ./
COPY .npmrc ./.npmrc

# Install all dependencies directly in place
RUN bun install --frozen-lockfile

# Generate Prisma Client
RUN bun --cwd packages/database db:generate

# --------------------------------------------------
# Runtime
# --------------------------------------------------
FROM oven/bun:1-slim AS runner

WORKDIR /app

ENV NODE_ENV=production

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Copy everything from builder to retain complete workspace node_modules structure
COPY --from=builder /app /app

CMD ["sh", "-c", "bun --cwd packages/database db:migrate && bun apps/bot/src/index.ts"]