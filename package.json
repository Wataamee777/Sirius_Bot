{
	"name": "sirius",
	"private": true,
	"version": "1.0.23",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev:web": "bun --cwd apps/web dev",
		"dev:bot": "bun --cwd @apps/bot dev",
		"build:web": "bun --cwd apps/web build",
		"build:bot": "bun --cwd apps/bot build",
		"check": "biome check .",
		"check:fix": "biome check . --write",
		"format": "biome format --write .",
		"typecheck": "tsc --build"
	},
	"dependencies": {
		"@prisma/client": "^7.9.1",
		"dotenv": "^17.4.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"prisma": "^7.9.1"
	}
}
